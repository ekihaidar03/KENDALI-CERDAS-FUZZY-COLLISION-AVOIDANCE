# Virtual environment
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter / notebook cache
.ipynb_checkpoints/

